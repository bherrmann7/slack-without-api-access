#!/usr/bin/env bash
# install — publish this working tree as the "released" edition.
#
# Cron runs slack-pr-sweep, which finds `slack-send` on PATH, which execs the
# DEPLOYED copy — never this directory. That is the whole point: editing
# send.js must not change what runs unattended against a shared channel five
# minutes later. Nothing reaches cron until you run this.
#
# The copy is a real copy, not a symlink. A symlink would put the working tree
# back in the execution path, so a branch switch or a half-saved edit would
# reach cron again.
set -euo pipefail

SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC="$SRC_DIR/send.js"
SWEEP_SRC="$SRC_DIR/pr-sweep.js"      # private; absent on a public clone
STATE_DIR="${SLACK_SEND_HOME:-$HOME/.slack-send}"
DEPLOY_DIR="$STATE_DIR/deploy"
DEPLOY="$DEPLOY_DIR/send.js"
DEPLOY_SWEEP="$DEPLOY_DIR/pr-sweep.js"
VERSION="$DEPLOY_DIR/VERSION.json"
BIN="$HOME/bin/slack-send"
BIN_SWEEP="$HOME/bin/slack-sweep"

say() { printf 'install: %s\n' "$1"; }
die() { printf 'install: %s\n' "$1" >&2; exit 1; }

[ -f "$SRC" ] || die "no send.js beside this script ($SRC)"

# ---------------------------------------------------------------- gates
# These are the only thing standing between an edit and ~165 unattended runs a
# day, so a failure here must stop the deploy rather than warn about it.

say "running tests…"
( cd "$SRC_DIR" && npm test >/dev/null 2>&1 ) || die "npm test FAILED — not deploying"
if [ -f "$SRC_DIR/test/pr-sweep.test.js" ]; then
  ( cd "$SRC_DIR" && node --test test/pr-sweep.test.js >/dev/null 2>&1 ) \
    || die "pr-sweep tests FAILED — not deploying"
fi

say "checking syntax…"
node --check "$SRC" || die "syntax error — not deploying"

# --check only proves the file parses. Removing a const while leaving a
# reference to it passes --check and dies at runtime; that happened for real.
# Actually executing a command is the cheapest way to catch it.
say "running send.js --help…"
node "$SRC" --help >/dev/null 2>&1 || die "send.js --help failed at runtime — not deploying"
if [ -f "$SWEEP_SRC" ]; then
  say "running pr-sweep.js --help…"
  node "$SWEEP_SRC" --help >/dev/null 2>&1 || die "pr-sweep.js --help failed at runtime — not deploying"
fi

# ---------------------------------------------------------------- deploy
mkdir -p "$DEPLOY_DIR"

HASH="$(shasum -a 256 "$SRC" | cut -c1-12)"
GIT_SHA="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
GIT_DIRTY=""
if [ -n "$GIT_SHA" ] && ! ( cd "$SRC_DIR" && git diff --quiet HEAD 2>/dev/null ); then
  GIT_DIRTY=" (dirty)"
fi

# Write beside the target and rename, so a sweep starting mid-install sees
# either the old file or the new one, never a half-written one.
cp "$SRC" "$DEPLOY.tmp"
chmod 755 "$DEPLOY.tmp"
mv -f "$DEPLOY.tmp" "$DEPLOY"

if [ -f "$SWEEP_SRC" ]; then
  cp "$SWEEP_SRC" "$DEPLOY_SWEEP.tmp"
  chmod 755 "$DEPLOY_SWEEP.tmp"
  mv -f "$DEPLOY_SWEEP.tmp" "$DEPLOY_SWEEP"
fi

cat > "$VERSION" <<EOF
{
  "hash": "$HASH",
  "deployedAt": "$(date '+%Y-%m-%d %H:%M:%S')",
  "source": "$SRC",
  "git": "${GIT_SHA:-}${GIT_DIRTY}"
}
EOF

# ---------------------------------------------------------------- wrapper
# slack-pr-sweep (the cron entry point) invokes `slack-send` through PATH, so
# repointing this one wrapper moves cron onto the deployed copy too.
mkdir -p "$HOME/bin"
# Back up ONCE. Copying on every run means the second install overwrites the
# original with a generated wrapper — a backup that cannot restore anything,
# which is worse than none because it looks like one.
if [ -f "$BIN" ] && [ ! -f "$BIN.bak" ]; then
  cp "$BIN" "$BIN.bak"
  say "kept your previous wrapper at $BIN.bak"
fi
cat > "$BIN" <<EOF
#!/usr/bin/env bash
# slack-send — released edition. Generated by $SRC_DIR/install; do not edit.
#
# This runs the DEPLOYED copy, not the working tree. To exercise uncommitted
# changes, run them explicitly from the project directory:
#     node $SRC <args>
set -euo pipefail
exec node $DEPLOY "\$@"
EOF
chmod 755 "$BIN"

if [ -f "$SWEEP_SRC" ]; then
  cat > "$BIN_SWEEP" <<EOF
#!/usr/bin/env bash
# slack-sweep — released edition. Generated by $SRC_DIR/install; do not edit.
set -euo pipefail
exec node $DEPLOY_SWEEP "\$@"
EOF
  chmod 755 "$BIN_SWEEP"
fi

# The cron entry point calls `slack-sweep` unconditionally. If the private
# sweep is not in this tree, that wrapper is never written (or is left stale),
# and cron fails every few minutes with nothing but a non-zero rc to show for
# it. Say so here rather than letting it be discovered from the log.
if [ ! -f "$SWEEP_SRC" ]; then
  say "note: no pr-sweep.js in this tree — slack-sweep not written (public clone?)"
  if [ -f "$HOME/bin/slack-pr-sweep" ]; then
    if [ -f "$BIN_SWEEP" ]; then
      say "WARNING: $HOME/bin/slack-pr-sweep still calls slack-sweep, which now"
      say "WARNING: points at a STALE deployed copy. Remove it, or restore pr-sweep.js."
    else
      say "WARNING: $HOME/bin/slack-pr-sweep calls slack-sweep, which does not exist."
      say "WARNING: scheduled sweeps will fail until pr-sweep.js is present here."
    fi
  fi
fi

say "deployed $HASH${GIT_SHA:+ (git ${GIT_SHA}${GIT_DIRTY})}"
say "  from  $SRC"
say "  to    $DEPLOY"
say "  via   $BIN"
[ -f "$SWEEP_SRC" ] && say "  and   $BIN_SWEEP -> $DEPLOY_SWEEP"
say "cron now runs this edition; editing send.js no longer affects it."
